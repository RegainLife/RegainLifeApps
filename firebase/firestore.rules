rules_version = '2';

// RegainLife Apps TOP のアクセスカウンタと意見箱のルール。
// Firebase コンソール → Firestore Database → ルール に貼り付けて公開する。
//
// コレクション:
//   stats/visits      { total }                         累計訪問数（誰でも読める・1ずつしか増やせない）
//   daily/{yyyymmdd}  { count }                         日本時間の当日の訪問数
//   likes/{page}      { count }                         ページのいいね数（誰でも読める・1ずつしか増やせない）
//   opinions/{id}     { uid, app, text, createdAt, editedAt?, reply?, thread?, editKey? }
//                                                       意見。本人と開発者だけが読める。メールアドレスは保存しない
//                                                       （以前の意見に残っている email は、開発者が開いたときに消す）
//                                                       thread は { m0: { by, text, at }, m1: ... } の形で、
//                                                       本人（by: 'user'）と開発者（by: 'dev'）が最後に1件ずつ足す。
//                                                       自分が書いた1件は直せる・消せる（editKey に番号を書く。
//                                                       消したものは deleted: true の印だけ残す）
//   limits/{uid}      { last, day, count }              送信間隔（1分）と1日の件数（10件）の記録
//   admins/{uid}      {}                                開発者。コンソールから手で作る（ページからは書けない）
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 日本時間の今日を 20261011 の形の整数で返す
    function todayInt() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function apps() {
      return ['SpiceClock', 'CalendarJP', 'Fast Mirror', 'Quark Timer', 'その他'];
    }

    match /stats/visits {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total == 1;
      allow update: if request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total == resource.data.total + 1;
    }

    match /daily/{day} {
      allow read: if true;
      allow create: if day == string(todayInt())
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if day == string(todayInt())
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    match /likes/{page} {
      allow read: if page == 'calendarjp-earthquake-beta';
      allow create: if page == 'calendarjp-earthquake-beta'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if page == 'calendarjp-earthquake-beta'
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
    }

    match /limits/{uid} {
      function own() {
        return signedIn() && request.auth.uid == uid;
      }
      function shapeOk() {
        let d = request.resource.data;
        return d.keys().hasAll(['last', 'day', 'count'])
          && d.keys().hasOnly(['last', 'day', 'count'])
          && d.last == request.time
          && d.day == todayInt();
      }

      allow get: if own();
      allow create: if own() && shapeOk() && request.resource.data.count == 1;
      allow update: if own() && shapeOk()
        && request.time > resource.data.last + duration.value(60, 's')
        && (
          (resource.data.day == todayInt()
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 10)
          || (resource.data.day != todayInt() && request.resource.data.count == 1)
        );
    }

    match /opinions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // 送信と同じ書き込みで limits/{uid} を更新したときだけ通す（間隔と件数の制限を必ず通らせる）
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['uid', 'app', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'app', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.app in apps()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;

      // 本人は本文だけ直せる（修正した時刻を editedAt に残す）
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.editedAt == request.time;

      // 開発者は、以前の意見に残っているメールアドレスを消せる（消すだけで、書き込みはできない）
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && !('email' in request.resource.data);

      // 開発者は返信だけ書ける（書き直しもできる）
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
        && request.resource.data.reply.keys().hasAll(['text', 'at'])
        && request.resource.data.reply.keys().hasOnly(['text', 'at'])
        && request.resource.data.reply.text is string
        && request.resource.data.reply.text.size() > 0
        && request.resource.data.reply.text.size() <= 4000
        && request.resource.data.reply.at == request.time;

      // スレッドの最後に 1 件だけ足す。番号は今の件数（m0, m1, ...）で、前の書き込みは変えられない
      function threadAppendOk(by, maxLen) {
        let old = resource.data.get('thread', {});
        let key = 'm' + string(old.size());
        let d = request.resource.data.thread.diff(old);
        let m = request.resource.data.thread[key];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread'])
          && old.size() < 100
          && d.addedKeys().hasOnly([key])
          && d.addedKeys().size() == 1
          && d.changedKeys().size() == 0
          && d.removedKeys().size() == 0
          && m.keys().hasAll(['by', 'text', 'at'])
          && m.keys().hasOnly(['by', 'text', 'at'])
          && m.by == by
          && m.text is string
          && m.text.size() > 0
          && m.text.size() <= maxLen
          && m.at == request.time;
      }

      // スレッドのうち、自分が書いた 1 件だけを直す・消す。どれを変えるかは editKey で受け取る。
      // 書いた人と最初の時刻は変えられず、消したものは二度と変えられない
      function threadEditOk(by, maxLen) {
        let key = request.resource.data.editKey;
        let old = resource.data.thread;
        let d = request.resource.data.thread.diff(old);
        let o = old[key];
        let m = request.resource.data.thread[key];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thread', 'editKey'])
          && key is string
          && d.changedKeys().hasOnly([key])
          && d.changedKeys().size() == 1
          && d.addedKeys().size() == 0
          && d.removedKeys().size() == 0
          && o.by == by
          && o.get('deleted', false) == false
          && m.by == by
          && m.at == o.at
          && m.keys().hasAll(['by', 'text', 'at', 'editedAt'])
          && m.keys().hasOnly(['by', 'text', 'at', 'editedAt', 'deleted'])
          && m.editedAt == request.time
          && m.text is string
          && m.text.size() <= maxLen
          && m.get('deleted', false) is bool
          && (m.text.size() > 0 || m.get('deleted', false) == true);
      }

      // 本人はスレッドに返信を足せる。自分の返信は直せる・消せる
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && (threadAppendOk('user', 2000) || threadEditOk('user', 2000));

      // 開発者はスレッドに返信を足せる。自分の返信は直せる・消せる
      allow update: if isAdmin()
        && (threadAppendOk('dev', 4000) || threadEditOk('dev', 4000));

      allow delete: if isAdmin();
    }

    // ここに書いていない場所はすべて読み書き禁止
  }
}
